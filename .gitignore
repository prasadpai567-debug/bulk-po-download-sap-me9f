# Excel temporary and lock files
~$*.xls*
*.tmp
*.bak

# Office workbooks and macro-enabled files are excluded by default
*.xls
*.xlsx
*.xlsm
*.xlsb
*.xlam

# Macro outputs and private business data
*.pdf
*.csv
!sample-data/*.csv
data/private/
exports/
screenshots/raw/

# Extracted Office/VBA internals
vbaProject.bin
work/

# Common local development artifacts
.venv/
venv/
__pycache__/
*.py[cod]
